# LayerVault host storage locations
#
# Copy this file to `.env` beside docker-compose.yml, edit the paths, then run:
#   docker compose up -d --build
#
# Windows local drive example: C:/LayerVault/data
# Windows NAS example:         //PRINT-NAS/3d-library
# Linux local/NAS example:     /mnt/storage/layervault

# Container timezone used for timestamps and schedules.
LAYERVAULT_TIMEZONE=Europe/London

# Optional protection for the main LayerVault application on port 8088.
# Leave APP_PASSWORD empty to disable. Workshop on port 3004 remains LAN-only.
APP_USERNAME=admin
APP_PASSWORD=

# These four host paths are the live locations LayerVault uses on startup.
# They may be relative local folders, absolute host paths or mounted shares.

# Working files, imports, thumbnails, print photos and Workshop projects.
LAYERVAULT_DATA_PATH=./data

# SQLite database directory. Prefer a local filesystem rather than SMB/NFS.
# The backwards-compatible default keeps layervault.db in ./data.
LAYERVAULT_DATABASE_PATH=./data

# Original STL, OBJ, 3MF and other model files.
LAYERVAULT_MODELS_PATH=./data/files

# Manual and scheduled backup ZIP archives. This may point at a different disk
# or NAS share from the live database and models.
LAYERVAULT_BACKUPS_PATH=./data/backups

# Administrator-approved parent folders available to Settings > Apply & restart.
# They may be local disks or host-mounted SMB/NFS shares. Keep these as narrow as
# practical; LayerVault cannot browse outside them. Multiple slots may reference
# the same parent share.
#
# Linux examples:  /mnt/nas, /media/usb, /srv/printing, /home/user/LayerVault
# Windows examples: D:/LayerVault, E:/3D-Models, //NAS/Media/3D-Printing
LAYERVAULT_STORAGE_ROOT_1=./data
LAYERVAULT_STORAGE_ROOT_2=./data
LAYERVAULT_STORAGE_ROOT_3=./data/files
LAYERVAULT_STORAGE_ROOT_4=./data/backups
